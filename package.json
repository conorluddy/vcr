{
  "name": "vcr-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "vcr": "tsx packages/cli/src/index.ts",
    "validate": "tsx packages/cli/src/index.ts validate",
    "doctor": "tsx packages/cli/src/index.ts doctor --record",
    "test": "vitest run",
    "typecheck": "tsc -b packages/cli packages/timeline packages/capture && tsc -p tsconfig.fixtures.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "~0.25.12",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
