{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vcr.local/schemas/workspace.schema.json",
  "title": "VCR workspace marker (vcr.json)",
  "type": "object",
  "required": ["schema_version", "harness_version", "projects"],
  "properties": {
    "schema_version": { "type": "string" },
    "harness_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "projects": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "storage": {
      "type": "object",
      "description": "Budgets that warn in vcr status, vcr validate and vcr storage; nothing is ever deleted automatically (plugin PRD §6.5)",
      "properties": {
        "output_warn_bytes": { "type": "integer", "minimum": 0, "description": "Default 5 GB per workspace" },
        "evidence_warn_bytes": { "type": "integer", "minimum": 0, "description": "Default 2 MB per video" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
