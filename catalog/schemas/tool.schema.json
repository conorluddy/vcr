{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vcr.local/schemas/tool.schema.json",
  "title": "VCR tool registry",
  "type": "object",
  "required": ["schema_version", "resources"],
  "properties": {
    "schema_version": { "type": "string" },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "role", "official_url", "automation_route", "capabilities", "documentation_status", "installation_status", "validation", "adapter_maturity"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "role": { "type": "string" },
          "official_url": { "type": "string", "format": "uri" },
          "automation_route": { "type": "string" },
          "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "documentation_status": { "type": "string" },
          "installation_status": { "enum": ["unknown", "installed", "missing", "not-applicable"] },
          "validation": {
            "type": "object",
            "required": ["status", "evidence"],
            "properties": {
              "status": { "enum": ["not-validated", "partial", "validated", "blocked"] },
              "evidence": { "type": "array", "items": { "type": "object" } }
            },
            "additionalProperties": true
          },
          "adapter_maturity": { "enum": ["none", "experimental", "supported", "deprecated"] },
          "checked_at": { "type": ["string", "null"], "format": "date" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
