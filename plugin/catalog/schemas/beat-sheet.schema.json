{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vcr.local/schemas/beat-sheet.schema.json",
  "title": "VCR beat sheet",
  "description": "A video's plan, projects/<project>/videos/<video>/beats.json, beside brief.md (references/story KB §4.2, §9.1). The source of truth for the timed plan; `vcr plan check` runs the STORY-* plan checks on it. The required beat fields are STORY-BEAT-FIELDS: a beat without them is not buildable.",
  "type": "object",
  "required": ["schema_version", "video_id", "fps", "target_s", "beats"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "string" },
    "video_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "fps": { "type": "number", "exclusiveMinimum": 0, "description": "One of the video brief's deliverable rates" },
    "target_s": { "type": "number", "exclusiveMinimum": 0, "description": "Target runtime; beat durations sum to it exactly in frames (STORY-BEAT-SUM)" },
    "mechanism": { "type": "string", "description": "How the idea works: demonstration, metaphor, problem-solution… (KB §3)" },
    "beats": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/beat" } }
  },
  "additionalProperties": false,
  "$defs": {
    "beat": {
      "type": "object",
      "description": "STORY-BEAT-FIELDS: id, purpose, must_show, on_screen_text, vo, duration_s and both transitions are required.",
      "required": ["id", "purpose", "must_show", "on_screen_text", "vo", "duration_s", "transition_in", "transition_out"],
      "properties": {
        "id": { "type": "string", "pattern": "^B\\d{2,}$", "description": "Stable; also the named marker id in the scene" },
        "role": { "enum": ["hook", "promise", "payoff", "rest", "cta"], "description": "Marker role (scene contract)" },
        "purpose": { "type": "string", "minLength": 1, "description": "One sentence: what the viewer understands or feels" },
        "must_show": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "on_screen_text": { "type": ["string", "null"], "description": "Verbatim copy, or null" },
        "vo": { "type": ["string", "null"], "description": "Verbatim narration, or null" },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 },
        "transition_in": { "type": "string", "minLength": 1 },
        "transition_out": { "type": "string", "minLength": 1 },
        "sound_cues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["t", "cue"],
            "properties": { "t": { "type": "number", "minimum": 0, "description": "Seconds from the beat's start" }, "cue": { "type": "string", "minLength": 1 } },
            "additionalProperties": false
          }
        },
        "mandatories": { "type": "array", "items": { "type": "string" }, "description": "IDs of series brief mandatories this beat satisfies" },
        "claims": { "type": "array", "items": { "type": "string" } },
        "board_frames": { "type": "array", "items": { "type": "string" } },
        "aspects": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
