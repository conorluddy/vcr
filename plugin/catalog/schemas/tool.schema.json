{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vcr.local/schemas/tool.schema.json",
  "title": "VCR tool registry index",
  "description": "Generated by `vcr catalog build` from catalog/tools/*.json. Edit the per-tool files, never this index. Records are validated in their own files; here only the shape is checked.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_from",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generated_from": {
      "const": "catalog/tools/*.json"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "tier",
          "role"
        ]
      }
    }
  },
  "additionalProperties": false
}
