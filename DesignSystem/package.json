{
  "name": "@vcr/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VCRStudio design system: tokens, React components with CSS modules, and the build that publishes them as a Claude Design System artifact.",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.json": "./tokens/tokens.json"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "check": "biome check . && tsc -p tsconfig.json",
    "format": "biome check --write .",
    "test": "vitest run",
    "verify": "pnpm check && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "18.3.29",
    "@types/react-dom": "18.3.7",
    "esbuild": "~0.25.12",
    "jsdom": "30.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "license": "Apache-2.0"
}
