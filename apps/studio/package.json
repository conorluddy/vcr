{
  "name": "@vcr/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VCR Studio: the design exploration app (PRD-0001), built on the VCRStudio design system.",
  "scripts": {
    "dev": "pnpm build:system && vite",
    "build": "pnpm build:system && vite build",
    "preview": "vite preview",
    "check": "biome check . && tsc -p tsconfig.json",
    "format": "biome check --write .",
    "test": "vitest run",
    "verify": "pnpm check && pnpm test && pnpm build",
    "build:system": "pnpm --filter @vcr/design-system build"
  },
  "dependencies": {
    "@vcr/design-system": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "18.3.29",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.0.5"
  },
  "license": "Apache-2.0"
}
